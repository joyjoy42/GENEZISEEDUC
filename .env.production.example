# Modèle de configuration pour le serveur de production.
# À copier en .env sur le serveur, puis à compléter. Ne jamais committer le .env.

APP_NAME="GENEZISE Éducation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-MOI.example.org

APP_LOCALE=fr
# Volontairement en anglais : si une traduction française manque, mieux vaut
# une phrase anglaise qu'une clé brute du type « validation.something ».
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# error : on ne garde que ce qui compte. debug remplirait le disque.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# SQLite suffit largement ici, et se sauvegarde en copiant un seul fichier.
# Le chemin doit être absolu, et le DOSSIER qui le contient doit être
# accessible en écriture : SQLite y écrit aussi les fichiers -wal et -shm.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/genezise/database/database.sqlite

# Cookies de session : HTTPS uniquement, et chiffrés.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Aucun e-mail n'est envoyé par l'application pour l'instant.
MAIL_MAILER=log
